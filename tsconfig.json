    "module": "commonjs",
    "declaration": false,
    "moduleResolution": "node",
    "sourceMap": true,
    "noImplicitAny": false,
    "lib": ["es2015", "dom"],
    "types": [
      "jquery",
      "core-js",
      "jest"
    ],
    "baseUrl": ".",
