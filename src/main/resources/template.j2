{
  "name": "fr.cgi~edt",
  "config": {
    "main" : "fr.cgi.edt.Edt",
    "probes": [
      "org.entcore.common.http.health.Neo4jProbe",
      "org.entcore.common.http.health.MongoProbe",
      "org.entcore.common.http.health.PostgresProbe"
    ],
    "port" : 8168,
    "app-name" : "Edt",
    "app-address" : "/edt",
    "app-icon" : "Edt-large",
    "host": "https://{{ host }}",
    "ssl" : true,
    {% if overrideTheme %} "override-theme": {{ override2d }}, {% endif %}
    "auto-redeploy": false,
    "userbook-host": "https://{{ host }}",
    "integration-mode": "{{ integration_mode|default('HTTP') }}",
    "app-registry.port" : 8012,
    "mode" : "prod",
    "sql": true,
    "holidays": {
      "public-holidays": "{{ publicHolidays | default('https://calendrier.api.gouv.fr') }}",
      "school-holidays": "{{ schoolHolidays | default('https://data.education.gouv.fr') }}" 
    },
    "db-schema" : "edt",
    "dependencies" : {
        "fr.openent.viescolaire": "1.0.0"
    },
    "entcore.port" : 8009,
    "publicConf": {
      "screeb-app-id": "{{ screebAppId | default('55edb49f-f5ac-4519-8d20-71e16929d626') }}"
    }
  }
}