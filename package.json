{
  "name": "edt",
  "version": "3.2.5-dev.0",
  "description": "Gestion d'emplois du temps au sein de l'OPEN-ENT-NG",
  "main": "gulpfile.js",
  "dependencies": {
    "@screeb/sdk-browser": "0.7.0",
    "apexcharts": "^3.15.5",
    "axios": "0.21.1",
    "core-js": "2.4.1",
    "entcore": "dev",
    "entcore-toolkit": "^1.0.1",
    "moment": "^2.21.0",
    "or": "^0.2.0",
    "underscore": "^1.8.3",
    "yargs": "^8.0.2"
  },
  "devDependencies": {
    "@types/angular": "1.8.3",
    "@types/core-js": "0.9.42",
    "@types/jest": "^22.2.0",
    "@types/jquery": "^2.0.34",
    "@types/node": "14.14.28",
    "awesome-typescript-loader": "3.2.1",
    "axios-mock-adapter": "^1.19.0",
    "browser-sync": "^3.0.2",
    "concurrently": "^9.0.0",
    "entcore-css-lib": "npm:ode-csslib@4.0.12",
    "sass": "^1.49.9",
    "gulp": "4.0.2",
    "gulp-clean": "0.4.0",
    "gulp-concat": "^2.6.1",
    "gulp-replace": "^1.0.0",
    "gulp-sourcemaps": "^2.6.0",
    "http-proxy": "^1.18.1",
    "jest": "^22.4.0",
    "jest-environment-node": "^23.0.0",
    "merge2": "^1.1.0",
    "ts-jest": "^22.4.2",
    "ts-loader": "^3.2.0",
    "typescript": "2.4.1",
    "webpack": "3.1.0",
    "webpack-stream": "3.2.0"
  },
  "scripts": {
    "coverage": "./node_modules/.bin/jest --config jest.config.js --forceExit --coverage",
    "clean": "rm -rf build && rm -rf src/main/resources/public/dist && rm -rf coverage && rm -rf src/main/resources/public/js && rm -rf node_modules",
    "test": "npm run clean && npm run coverage",
    "build": "NODE_OPTIONS=--openssl-legacy-provider node node_modules/gulp/bin/gulp.js build",
    "watch:ts": "NODE_OPTIONS=--openssl-legacy-provider node node_modules/gulp/bin/gulp.js watch-dev",
    "build:sass": "sass --load-path=node_modules/ --no-source-map src/main/resources/public/sass/index.scss src/main/resources/public/css/edt.css",
    "watch:sass": "node scripts/dev-sass.js",
    "dev:server": "node dev-server.js",
    "dev": "concurrently --kill-others-on-fail -n webpack,sass,serve -c blue,magenta,green \"yarn run watch:ts\" \"yarn run watch:sass\" \"yarn run dev:server\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web-education/pages.git"
  },
  "author": "",
  "license": "Propriétaire",
  "bugs": {
    "url": ""
  },
  "homepage": ""
}
